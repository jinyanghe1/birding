{"species": {"id": 22, "common_name_cn": "白鹭", "common_name_en": "Little Egret", "scientific_name": "Egretta garzetta", "family_cn": "鹭科", "order_cn": null, "iucn_status": "LC", "china_protection": null, "endemic_cn": 0, "created_at": "2026-08-28T19:30:34+08:00", "family_latin": null, "order_latin": null, "in_china": 1, "inat_id": null, "gbif_key": null, "wikipedia_url": null, "summary": "白鹭，又称小白鹭，是鷺科中的一種小型鷺。牠是一種白色的鳥，具有細長的黑色喙、長黑腿，以及在西部種群中有黃色的腳。作為一種水鳥，牠在淺水和陸地上覓食，食用各種小型生物。繁殖有群居習性，常與其他水鳥一起，在樹、灌木或蘆葦灘上用樹枝搭建巢穴。每窩產下三到五枚藍綠色的蛋，由雙親共同孵育約三週。幼鳥大約在六週大時長出成鳥羽毛。\n", "links_json": "{\"维基百科\": \"https://zh.wikipedia.org/wiki/%E7%99%BD%E9%B9%AD\", \"eBird\": \"https://ebird.org/species/litegr\", \"Cornell 世界鸟类\": \"https://birdsoftheworld.org/bow/species/litegr\", \"eBird 搜索\": \"https://ebird.org/search?query=Egretta%20garzetta\", \"Xeno-canto 鸟鸣\": \"https://xeno-canto.org/explore?query=sp%3A%22Egretta%20garzetta%22\", \"GBIF\": \"https://www.gbif.org/species/search?q=Egretta%20garzetta\"}"}, "observations": [{"id": 36, "species_id": 22, "obs_date": "2026-08-25", "obs_time": "10:35:16", "latitude": null, "longitude": null, "place_name": null, "place_source": "none", "admin_region": null, "photo_count": 7, "best_sharpness": null, "confidence": 0.5573691129684448, "identified_by": "model", "notes": "本地模型识别（鸟框置信度 0.82），待复核", "created_at": "2026-08-28T19:30:35+08:00", "photos": [{"id": 2093, "obs_id": 36, "asset_uuid": "BDD81AE7-C235-47D9-8596-B4C1DED63D6A", "filename": null, "shot_at": "2026-08-25T10:33:52+08:00", "media_type": "image", "video_offset_sec": null, "image_source": "derivative", "image_path": "/Users/hejinyang/Pictures/Photos Library.photoslibrary/resources/derivatives/B/BDD81AE7-C235-47D9-8596-B4C1DED63D6A_1_105_c.jpeg", "thumb_cache": "thumbs/BDD81AE7-C235-47D9-8596-B4C1DED63D6A.jpg", "width": null, "height": null, "sharpness": 26.264425264863856, "phash": "94cb66d9ca66926c", "animal_conf": 0.7988491654396057, "is_representative": 1, "low_res": 0, "exif_json": null}, {"id