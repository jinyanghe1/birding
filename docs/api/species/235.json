{"species": {"id": 235, "common_name_cn": "绿头鸭", "common_name_en": "Mallard", "scientific_name": "Anas platyrhynchos", "family_cn": "鸭科", "order_cn": null, "iucn_status": "LC", "china_protection": null, "endemic_cn": 0, "created_at": "2026-08-28T19:31:43+08:00", "family_latin": null, "order_latin": null, "in_china": 1, "inat_id": null, "gbif_key": null, "wikipedia_url": null, "summary": "绿头鸭 又名大头绿（雄）、蒲鸭（雌）、野鴨，古稱鳧，是一種水鴨，在溫帶和亞熱帶的美洲、歐亞大陸和北非繁殖。它被引進到紐西蘭、澳大利亞、秘魯、巴西、烏拉圭、阿根廷、智利、哥倫比亞、福克蘭群島和南非。這種鴨屬於鴨亞科的雁形目鴨科。雄鴨（公鴨）有綠色頭部，而雌鴨（母鴨）主要有棕色斑點羽毛。兩性翅膀上都有一片稱為翼鏡羽的白邊黑色或虹彩紫色或藍色羽毛區域；雄鴨尤其傾向於有藍色翼鏡羽。\n", "links_json": "{\"维基百科\": \"https://zh.wikipedia.org/wiki/%E7%BB%BF%E5%A4%B4%E9%B8%AD\", \"eBird\": \"https://ebird.org/species/mallar1\", \"Cornell 世界鸟类\": \"https://birdsoftheworld.org/bow/species/mallar1\", \"eBird 搜索\": \"https://ebird.org/search?query=Anas%20platyrhynchos\", \"Xeno-canto 鸟鸣\": \"https://xeno-canto.org/explore?query=sp%3A%22Anas%20platyrhynchos%22\", \"GBIF\": \"https://www.gbif.org/species/search?q=Anas%20platyrhynchos\"}"}, "observations": [{"id": 299, "species_id": 235, "obs_date": "2026-05-29", "obs_time": "14:26:18", "latitude": 39.946862711490496, "longitude": 116.37462058806035, "place_name": "什刹海, 北京市, 中国", "place_source": "photos", "admin_region": "什刹海, 北京市", "photo_count": 2, "best_sharpness": 1985.3391858064167, "confidence": 0.5794588923454285, "identified_by": "model", "notes": "本地模型识别（鸟框置信度 0.74），待复核", "created_at": "2026-08-28T19:31:43+08:00", "photos": [{"id": 1315, "obs_id": 299, "asset_uuid": "25474387-E5FF-473C-9FFB-2F8D6ACD63E7", "filename": null, "shot_at": "2026-05-29T14:26:18.229000+08:00", "media_type": "image", "video_offset_sec": null, "image_source": "derivative", "image_path": "/Users/hejinyang/Pictures/Photos Library.photoslibrary/resources/derivatives/2/25474387-E5FF-473C-9FFB-2F8D6ACD63E7_1_105_c.jpeg", "thumb_cache": "thumbs/25474387-E5FF-473C-9FFB-2F8D6ACD63E7.jpg", "width": null, "height": null, "sharpness": 1990.6431459491125, "phash": "9