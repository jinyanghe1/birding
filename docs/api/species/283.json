{"species": {"id": 283, "common_name_cn": "红耳鹎", "common_name_en": "Red-whiskered Bulbul", "scientific_name": "Pycnonotus jocosus", "family_cn": "鹎科", "order_cn": null, "iucn_status": "LC", "china_protection": null, "endemic_cn": 0, "created_at": "2026-08-28T19:32:08+08:00", "family_latin": null, "order_latin": null, "in_china": 1, "inat_id": null, "gbif_key": null, "wikipedia_url": null, "summary": "红耳鵯，，又名红颊鹎，俗名高髻冠、高鸡冠、高冠鸟、黑头公、紅屎忽、gel頭雀等，原產於亞洲熱帶的鵯屬鳥類。是一種定居性食果動物，主要分佈於熱帶亞洲地區。它作為觀賞鳥被引入到世界上許多熱帶地區，並已在這些地區建立了族群。紅耳鵯有著響亮的三或四音節叫聲，主要以水果和小型昆蟲為食，喜歡顯眼地棲息在樹上。它常見於山林和城市花園。\n", "links_json": "{\"维基百科\": \"https://zh.wikipedia.org/wiki/%E7%BA%A2%E8%80%B3%E9%B9%8E\", \"eBird 搜索\": \"https://ebird.org/search?query=Pycnonotus%20jocosus\", \"Xeno-canto 鸟鸣\": \"https://xeno-canto.org/explore?query=sp%3A%22Pycnonotus%20jocosus%22\", \"GBIF\": \"https://www.gbif.org/species/search?q=Pycnonotus%20jocosus\"}"}, "observations": [{"id": 617, "species_id": 283, "obs_date": "2026-08-21", "obs_time": "14:37:29", "latitude": null, "longitude": null, "place_name": null, "place_source": "none", "admin_region": null, "photo_count": 6, "best_sharpness": null, "confidence": 0.34369388222694397, "identified_by": "model", "notes": "本地模型识别（鸟框置信度 0.76），待复核", "created_at": "2026-08-28T19:35:33+08:00", "photos": [{"id": 2021, "obs_id": 617, "asset_uuid": "E63AAE14-86C8-4DE2-87E1-E6ED5A864537", "filename": null, "shot_at": "2026-08-21T14:37:29+08:00", "media_type": "image", "video_offset_sec": null, "image_source": "derivative", "image_path": "/Users/hejinyang/Pictures/Photos Library.photoslibrary/resources/derivatives/E/E63AAE14-86C8-4DE2-87E1-E6ED5A864537_1_105_c.jpeg", "thumb_cache": "thumbs/E63AAE14-86C8-4DE2-87E1-E6ED5A864537.jpg", "width": null, "height": null, "sharpness": 4557.493924298554, "phash": "edd9d52a140ece16", "animal_conf": 0.698756217956543, "is_representative": 1, "low_res": 0, "exif_json": null}, {"id": 2041, "obs_id": 617, "asset_uuid": "37D1AC24-ABEC-4B44-AEEA-32A6CDCB0D38", "filename"