{"species": {"id": 29, "common_name_cn": "白胸翡翠", "common_name_en": "White-throated Kingfisher", "scientific_name": "Halcyon smyrnensis", "family_cn": "翠鸟科", "order_cn": null, "iucn_status": "LC", "china_protection": "二级", "endemic_cn": 0, "created_at": "2026-08-28T19:30:35+08:00", "family_latin": null, "order_latin": null, "in_china": 1, "inat_id": null, "gbif_key": null, "wikipedia_url": null, "summary": "白胸翡翠 又名苍翡翠，也叫白喉翡翠，廣泛分布於亞洲，從西奈半島向東延伸至印度次大陸、中國及印尼。這種翠鳥在大部分的分布區域內都是留鳥，儘管某些族群可能會進行短距離的移動。牠們經常出現在遠離水源的地方，捕食各種獵物，包括小型爬行動物、兩棲動物、螃蟹、小型囓齒類動物，甚至是鳥類。繁殖季節時，牠們會在早晨從顯眼的棲地（如城市區域的建築物頂端或電線上）大聲鳴叫。\n", "links_json": "{\"维基百科\": \"https://zh.wikipedia.org/wiki/%E7%99%BD%E8%83%B8%E7%BF%A1%E7%BF%A0\", \"eBird 搜索\": \"https://ebird.org/search?query=Halcyon%20smyrnensis\", \"Xeno-canto 鸟鸣\": \"https://xeno-canto.org/explore?query=sp%3A%22Halcyon%20smyrnensis%22\", \"GBIF\": \"https://www.gbif.org/species/search?q=Halcyon%20smyrnensis\"}"}, "observations": [{"id": 707, "species_id": 29, "obs_date": "2026-08-25", "obs_time": "17:31:36", "latitude": null, "longitude": null, "place_name": "深圳湾公园, 深圳市, 广东省, 中国", "place_source": "inferred", "admin_region": null, "photo_count": 13, "best_sharpness": null, "confidence": 0.9531495571136475, "identified_by": "model", "notes": "本地模型识别（鸟框置信度 0.92），待复核", "created_at": "2026-08-28T19:35:44+08:00", "photos": [{"id": 2117, "obs_id": 707, "asset_uuid": "F9E91C22-476A-493B-AD9E-D32F30AE2C87", "filename": null, "shot_at": "2026-08-25T17:23:07+08:00", "media_type": "image", "video_offset_sec": null, "image_source": "derivative", "image_path": "/Users/hejinyang/Pictures/Photos Library.photoslibrary/resources/derivatives/F/F9E91C22-476A-493B-AD9E-D32F30AE2C87_1_105_c.jpeg", "thumb_cache": "thumbs/F9E91C22-476A-493B-AD9E-D32F30AE2C87.jpg", "width": null, "height": null, "sharpness": 163.0981012929438, "phash": "9ee4269d41393ae6", "animal_conf": 0.8644684553146362, "is_representative": 1, "low_res": 0, "exif_json": null}, {"id": 2119, "obs_id": 707, "asset_uuid