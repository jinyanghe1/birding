{"species": {"id": 344, "common_name_cn": "丝光椋鸟", "common_name_en": "Red-billed Starling", "scientific_name": "Spodiopsar sericeus", "family_cn": "椋鸟科", "order_cn": null, "iucn_status": "LC", "china_protection": null, "endemic_cn": 0, "created_at": "2026-08-28T19:35:37+08:00", "family_latin": null, "order_latin": null, "in_china": 1, "inat_id": null, "gbif_key": null, "wikipedia_url": null, "summary": "丝光椋鸟 为椋鸟科絲光椋鳥屬的鸟类，俗名牛屎八哥、丝毛椋鸟，原以为是中国的特有物种，但是已经在越南发现。在中国主要分布于华南、自陕西、河南、安徽、江苏至广东、海南、西至四川、云南等地，多栖息于开阔平原、农作区和丛林间以及营巢于墙洞或树洞中。该物种的模式产地在中国。\n", "links_json": "{\"维基百科\": \"https://zh.wikipedia.org/wiki/%E4%B8%9D%E5%85%89%E6%A4%8B%E9%B8%9F\", \"eBird 搜索\": \"https://ebird.org/search?query=Spodiopsar%20sericeus\", \"Xeno-canto 鸟鸣\": \"https://xeno-canto.org/explore?query=sp%3A%22Spodiopsar%20sericeus%22\", \"GBIF\": \"https://www.gbif.org/species/search?q=Spodiopsar%20sericeus\"}"}, "observations": [{"id": 650, "species_id": 344, "obs_date": "2026-08-22", "obs_time": "15:00:06", "latitude": null, "longitude": null, "place_name": null, "place_source": "none", "admin_region": null, "photo_count": 9, "best_sharpness": null, "confidence": 0.9186147451400757, "identified_by": "model", "notes": "本地模型识别（鸟框置信度 0.90），待复核", "created_at": "2026-08-28T19:35:37+08:00", "photos": [{"id": 2063, "obs_id": 650, "asset_uuid": "9F8E7B90-D765-46B5-B901-A6C1C5ECA937", "filename": null, "shot_at": "2026-08-22T15:00:22+08:00", "media_type": "image", "video_offset_sec": null, "image_source": "derivative", "image_path": "/Users/hejinyang/Pictures/Photos Library.photoslibrary/resources/derivatives/9/9F8E7B90-D765-46B5-B901-A6C1C5ECA937_1_105_c.jpeg", "thumb_cache": "thumbs/9F8E7B90-D765-46B5-B901-A6C1C5ECA937.jpg", "width": null, "height": null, "sharpness": 111.43335720141316, "phash": "d27a75c6c8c9c1c3", "animal_conf": 0.7549427151679993, "is_representative": 1, "low_res": 0, "exif_json": null}, {"id": 2059, "obs_id": 650, "asset_uuid": "7CDE0EE4-E2DF-4E9D-BC58-4CD712DB832E", "filename": null, "shot_