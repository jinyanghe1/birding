{"species": {"id": 6, "common_name_cn": "黑领椋鸟", "common_name_en": "Black-collared Starling", "scientific_name": "Gracupica nigricollis", "family_cn": "椋鸟科", "order_cn": null, "iucn_status": "LC", "china_protection": null, "endemic_cn": 0, "created_at": "2026-08-28T19:30:22+08:00", "family_latin": null, "order_latin": null, "in_china": 1, "inat_id": null, "gbif_key": null, "wikipedia_url": null, "summary": "黑领椋鸟 为椋鸟科斑椋鳥屬的鸟类，又名乌领椋鸟，俗名黑脖八哥、白头椋鸟。牠的羽毛為黑白相間，並有一個黑色的領圈。這種鳥分布於中國南部及大部分的東南亞大陸地區，並已引入台灣、馬來西亞和新加坡。牠的棲地包括草原、乾燥森林以及人類居住區。國際自然保護聯盟（IUCN）已將其評估為無危物種。\n", "links_json": "{\"维基百科\": \"https://zh.wikipedia.org/wiki/%E9%BB%91%E9%A2%86%E6%A4%8B%E9%B8%9F\", \"eBird 搜索\": \"https://ebird.org/search?query=Gracupica%20nigricollis\", \"Xeno-canto 鸟鸣\": \"https://xeno-canto.org/explore?query=sp%3A%22Gracupica%20nigricollis%22\", \"GBIF\": \"https://www.gbif.org/species/search?q=Gracupica%20nigricollis\"}"}, "observations": [{"id": 748, "species_id": 6, "obs_date": "2026-08-26", "obs_time": "02:02:39", "latitude": null, "longitude": null, "place_name": null, "place_source": "none", "admin_region": null, "photo_count": 1, "best_sharpness": null, "confidence": 0.5185372233390808, "identified_by": "model", "notes": "本地模型识别（鸟框置信度 0.92），待复核", "created_at": "2026-08-28T19:35:48+08:00", "photos": [{"id": 2168, "obs_id": 748, "asset_uuid": "61FFB850-9762-4A08-A1A1-8CEC8BCDF97B", "filename": null, "shot_at": "2026-08-26T02:02:39+08:00", "media_type": "video", "video_offset_sec": null, "image_source": "derivative", "image_path": "/Users/hejinyang/Pictures/Photos Library.photoslibrary/resources/derivatives/6/61FFB850-9762-4A08-A1A1-8CEC8BCDF97B_1_102_o.jpeg", "thumb_cache": "thumbs/61FFB850-9762-4A08-A1A1-8CEC8BCDF97B.jpg", "width": null, "height": null, "sharpness": 624.9594149324032, "phash": "91ebca761f8564a2", "animal_conf": 0.9020302295684814, "is_representative": 1, "low_res": 0, "exif_json": null}]}, {"id": 677, "species_id": 6, "obs_date": "2026-08-25", "obs_time": "10:31:18", "latitude